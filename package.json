{
    "name": "wapala-website",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.14 <25"
    },
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1 -p 3100",
        "local": "tsx scripts/local.ts",
        "email:send": "tsx scripts/email-worker.ts",
        "build": "prisma generate && next build",
        "start": "node scripts/start.mjs",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/unit/*.test.ts",
        "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
        "test:e2e": "playwright test",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "admin:create": "tsx scripts/admin-create.ts"
    },
    "dependencies": {
        "@fontsource/source-sans-3": "5.3.0",
        "@fontsource/source-serif-4": "5.3.0",
        "@inquirer/prompts": "8.7.2",
        "@prisma/client": "6.19.3",
        "better-auth": "1.7.4",
        "dotenv": "17.2.3",
        "exceljs": "4.4.0",
        "fast-xml-parser": "5.11.1",
        "jszip": "3.10.1",
        "lucide-react": "1.45.0",
        "next": "16.3.5",
        "nodemailer": "10.0.9",
        "pdf-lib": "1.17.1",
        "prisma": "6.19.3",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "sanitize-html": "2.17.7",
        "sharp": "0.35.4",
        "tsx": "4.21.0",
        "yauzl": "3.4.0",
        "zod": "4.6.5"
    },
    "overrides": {
        "deepmerge-ts": "8.0.0",
        "uuid": "11.1.1",
        "esbuild": "0.28.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@playwright/test": "1.63.0",
        "@types/node": "^22.0.0",
        "@types/nodemailer": "^7.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/sanitize-html": "^2.16.0",
        "@types/yauzl": "^2.10.3",
        "embedded-postgres": "18.4.0-beta.17",
        "prettier": "3.9.6",
        "typescript": "^5.9.0"
    }
}
