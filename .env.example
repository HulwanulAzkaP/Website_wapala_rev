# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/wapala
BETTER_AUTH_URL=https://your-domain.example
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
STORAGE_DIR=./var/storage

# Optional: enable the one-time /setup route on a fresh database
ALLOW_INITIAL_SETUP=true

# Optional: outgoing mail (recruitment notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
